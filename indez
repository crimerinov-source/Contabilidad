    function escapeHtml(str) {
      return String(str || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    function escapeAttr(str) {
      return escapeHtml(str).replace(/'/g, "&#39;");
    }

    // =========================================================================
    // PESTAÑA 1: RESUMEN DASHBOARD
    // =========================================================================
    function onDashboardPeriodChange() {
      const dashMes = document.getElementById("dash-mes");
      const dashAnio = document.getElementById("dash-anio");
      if (dashMes && MESES.includes(dashMes.value)) {
        appState.activeMes = dashMes.value;
      }
      if (dashAnio) {
        const y = parseInt(dashAnio.value, 10);
        if (Number.isFinite(y)) appState.activeAnio = y;
      }
      saveAppState();
      renderDashboardTab();
    }

    function getMonthSummary(mes, anio) {
      const gastosMes = appState.gastos.filter(g => {
        const p = parseDateParts(g.fecha);
        return p.mes === mes && p.anio === anio;
      });
      const ingresosMes = appState.ingresos.filter(i => {
        const p = parseDateParts(i.fecha);
        return p.mes === mes && p.anio === anio;
      });

      const totalIngresos = ingresosMes.reduce((s, x) => s + (Number(x.monto) || 0), 0);
      const totalGastos = gastosMes.reduce((s, x) => s + (Number(x.monto) || 0), 0);
      const gastoNecesario = gastosMes.filter(x => x.tipo === "Necesario").reduce((s, x) => s + (Number(x.monto) || 0), 0);
      const gastoInnecesario = gastosMes.filter(x => x.tipo === "Innecesario").reduce((s, x) => s + (Number(x.monto) || 0), 0);
      const ahorroNeto = totalIngresos - totalGastos;
      const capitalInicial = Number(appState.capitalPorMes[mes] || 0);
      const capitalActual = capitalInicial + ahorroNeto;
      const pctAhorro = totalIngresos > 0 ? (ahorroNeto / totalIngresos) : 0;

      return {
        gastosMes,
        ingresosMes,
        totalIngresos,
        totalGastos,
        gastoNecesario,
        gastoInnecesario,
        ahorroNeto,
        capitalInicial,
        capitalActual,
        pctAhorro
      };
    }

    function renderDashboardTab() {
      const mes = appState.activeMes;
      const anio = appState.activeAnio;
      const sum = getMonthSummary(mes, anio);

      const mesLbl = document.getElementById("dash-cap-mes-label");
      const capIniEl = document.getElementById("dash-cap-inicial");
      const contEl = document.getElementById("dash-contador");

      if (mesLbl) mesLbl.textContent = mes;
      if (capIniEl) capIniEl.textContent = fmtMoney(sum.capitalInicial);
      if (contEl) {
        const nMovs = sum.gastosMes.length + sum.ingresosMes.length;
        contEl.textContent = `${nMovs} movimiento${nMovs === 1 ? "" : "s"} en ${mes} ${anio} (${sum.ingresosMes.length} ing. / ${sum.gastosMes.length} gas.)`;
      }

      // 6 KPIs
      setText("kpi-capital-actual", fmtMoney(sum.capitalActual));
      setText("kpi-ingresos", fmtMoney(sum.totalIngresos));
      setText("kpi-gastos", fmtMoney(sum.totalGastos));
      const ahorroEl = document.getElementById("kpi-ahorro-neto");
      if (ahorroEl) {
        ahorroEl.textContent = fmtMoney(sum.ahorroNeto);
        ahorroEl.style.color = sum.ahorroNeto >= 0 ? "var(--emerald)" : "var(--rose)";
      }
      setText("kpi-innecesario", fmtMoney(sum.gastoInnecesario));
      setText("kpi-pct-ahorro", fmtPct(sum.pctAhorro));

      // Tabla Categorías y Presupuesto
      const tbodyCat = document.getElementById("tbody-dash-categorias");
      const tfootCat = document.getElementById("tfoot-dash-categorias");
      let totalPresup = 0;
      const catNames = [];
      const catSpentList = [];

      if (tbodyCat) {
        tbodyCat.innerHTML = appState.categorias.map((cat, idx) => {
          const presup = Number(cat.presupuesto) || 0;
          totalPresup += presup;
          const gastado = sum.gastosMes
            .filter(g => g.categoria === cat.nombre)
            .reduce((acc, g) => acc + (Number(g.monto) || 0), 0);

          catNames.push(cat.nombre);
          catSpentList.push(gastado);

          const ratioPresup = presup > 0 ? (gastado / presup) : 0;
          const ratioTotal = sum.totalGastos > 0 ? (gastado / sum.totalGastos) : 0;

          let badgeCls = "badge-ok";
          if (presup > 0 && ratioPresup > 1) badgeCls = "badge-over";
          else if (presup > 0 && ratioPresup >= 0.8) badgeCls = "badge-warn";

          const pctLabel = presup > 0 ? fmtPct(ratioPresup) : (gastado > 0 ? "Sin presup." : "0.0%");

          return `
            <tr>
              <td><strong>${escapeHtml(cat.nombre)}</strong></td>
              <td class="right">
                <input type="number" step="1" min="0" value="${presup}" class="num" style="width: 84px; text-align: right;"
                  onchange="updateCategoryBudget(${idx}, this.value)" />
              </td>
              <td class="right num" style="font-weight: 700;">${fmtMoney(gastado)}</td>
              <td class="center"><span class="badge ${badgeCls} num">${pctLabel}</span></td>
              <td class="right num">${fmtPct(ratioTotal)}</td>
            </tr>
          `;
        }).join("");
      }

      if (tfootCat) {
        const totalRatioPresup = totalPresup > 0 ? fmtPct(sum.totalGastos / totalPresup) : "—";
        tfootCat.innerHTML = `
          <tr>
            <td>TOTAL GENERAL (${mes} ${anio})</td>
            <td class="right num">${fmtMoney(totalPresup)}</td>
            <td class="right num" style="color: #2dd4bf;">${fmtMoney(sum.totalGastos)}</td>
            <td class="center num">${totalRatioPresup}</td>
            <td class="right num">100.0%</td>
          </tr>
        `;
      }

      // Tabla Calidad del Gasto
      const tbodyCal = document.getElementById("tbody-dash-calidad");
      const rNec = sum.totalGastos > 0 ? (sum.gastoNecesario / sum.totalGastos) : 0;
      const rInn = sum.totalGastos > 0 ? (sum.gastoInnecesario / sum.totalGastos) : 0;
      if (tbodyCal) {
        tbodyCal.innerHTML = `
          <tr>
            <td><span class="badge badge-ok">Necesario</span></td>
            <td class="right num" style="font-weight: 700;">${fmtMoney(sum.gastoNecesario)}</td>
            <td class="right num">${fmtPct(rNec)}</td>
            <td>Gastos esenciales para el mes</td>
          </tr>
          <tr>
            <td><span class="badge badge-over">Innecesario</span></td>
            <td class="right num" style="font-weight: 700; color: var(--rose);">${fmtMoney(sum.gastoInnecesario)}</td>
            <td class="right num">${fmtPct(rInn)}</td>
            <td>Potencial ahorro si se evita este rubro</td>
          </tr>
        `;
      }

      const diagEl = document.getElementById("diagnostico-calidad");
      setText("chart-cat-sub", `${mes} ${anio} • ${sum.gastosMes.length} gastos`);
      setText("chart-cal-sub", `${mes} ${anio} • Ahorro evitable: ${fmtMoney(sum.gastoInnecesario)}`);
      if (diagEl) {
        if (sum.totalGastos <= 0) {
          diagEl.textContent = `Sin gastos registrados en ${mes} ${anio}.`;
        } else {
          diagEl.textContent = `En ${mes} ${anio}, el ${fmtPct(rInn)} (${fmtMoney(sum.gastoInnecesario)}) fue innecesario y el ${fmtPct(rNec)} (${fmtMoney(sum.gastoNecesario)}) fue necesario.`;
        }
      }

      renderMetasTable();
      renderArqueoCuentasYPrestamos();

      drawBarChart("canvas-categorias", catNames, catSpentList, "#0d9488", `${mes} ${anio}`);
      drawDonutChart("canvas-calidad", ["Necesario", "Innecesario"], [sum.gastoNecesario, sum.gastoInnecesario], ["#059669", "#e11d48"]);
    }

    function setText(id, val) {
      const el = document.getElementById(id);
      if (el) el.textContent = val;
    }

    function updateCategoryBudget(idx, val) {
      if (!appState.categorias[idx]) return;
      const num = parseFloat(val);
      appState.categorias[idx].presupuesto = Number.isFinite(num) && num >= 0 ? num : 0;
      saveAppState();
      renderDashboardTab();
      notify("Presupuesto actualizado");
    }

    function renderMetasTable() {
      const tbody = document.getElementById("tbody-metas");
      if (!tbody) return;
      tbody.innerHTML = appState.metas.map((m, idx) => {
        const obj = Number(m.objetivo) || 0;
        const aho = Number(m.ahorrado) || 0;
        const falta = Math.max(0, obj - aho);
        const pct = obj > 0 ? Math.min(1, Math.max(0, aho / obj)) : 0;

        return `
          <tr>
            <td><strong>${escapeHtml(m.nombre)}</strong></td>
            <td class="right">
