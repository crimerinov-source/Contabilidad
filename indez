    function showErrorBanner(message) {
      const banner = document.getElementById("error-banner");
      const detail = document.getElementById("error-detail");
      if (banner && detail) {
        detail.textContent = String(message || "Error inesperado");
        banner.style.display = "block";
      }
    }

    window.addEventListener("error", function (event) {
      showErrorBanner(event && event.message ? event.message : "Error de ejecución en script");
    });

    window.addEventListener("unhandledrejection", function (event) {
      const reason = event && event.reason ? (event.reason.message || String(event.reason)) : "Promesa rechazada";
