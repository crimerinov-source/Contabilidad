    function normalizeState(rawObj) {
      const def = getDefaultData();
      if (!rawObj || typeof rawObj !== "object") return def;

      const capMap = {};
      MESES.forEach(m => {
        const v = rawObj.capitalPorMes && Object.prototype.hasOwnProperty.call(rawObj.capitalPorMes, m)
          ? Number(rawObj.capitalPorMes[m])
          : Number(def.capitalPorMes[m]);
        capMap[m] = Number.isFinite(v) ? v : 0;
      });

      return {
        activeMes: MESES.includes(rawObj.activeMes) ? rawObj.activeMes : def.activeMes,
        activeAnio: Number.isFinite(Number(rawObj.activeAnio)) ? Number(rawObj.activeAnio) : def.activeAnio,
        categorias: Array.isArray(rawObj.categorias) && rawObj.categorias.length
          ? rawObj.categorias.map(c => ({
              nombre: String(c && c.nombre ? c.nombre : "Otros"),
              presupuesto: Number.isFinite(Number(c && c.presupuesto)) ? Number(c.presupuesto) : 0
            }))
          : def.categorias,
        metodos: Array.isArray(rawObj.metodos) && rawObj.metodos.length ? rawObj.metodos.map(String) : def.metodos,
        fuentes: Array.isArray(rawObj.fuentes) && rawObj.fuentes.length ? rawObj.fuentes.map(String) : def.fuentes,
        deudores: Array.isArray(rawObj.deudores) && rawObj.deudores.length ? rawObj.deudores.map(String) : def.deudores,
        capitalPorMes: capMap,
        arqueo: {
          billetes: Number.isFinite(Number(rawObj.arqueo && rawObj.arqueo.billetes)) ? Number(rawObj.arqueo.billetes) : def.arqueo.billetes,
          monedas: Number.isFinite(Number(rawObj.arqueo && rawObj.arqueo.monedas)) ? Number(rawObj.arqueo.monedas) : def.arqueo.monedas
        },
        cuentas: {
          bancomovil: Number.isFinite(Number(rawObj.cuentas && rawObj.cuentas.bancomovil)) ? Number(rawObj.cuentas.bancomovil) : def.cuentas.bancomovil,
          deuna: Number.isFinite(Number(rawObj.cuentas && rawObj.cuentas.deuna)) ? Number(rawObj.cuentas.deuna) : def.cuentas.deuna
        },
        prestamos: Array.isArray(rawObj.prestamos)
          ? rawObj.prestamos.map((p, idx) => ({
              id: p && p.id ? p.id : Date.now() + idx,
              fecha: p && p.fecha ? String(p.fecha) : "2026-11-01",
              deudor: p && p.deudor ? String(p.deudor) : (Array.isArray(rawObj.deudores) && rawObj.deudores[0]) || "Geovanny",
              estado: p && p.estado === "Pagado" ? "Pagado" : "Pendiente",
              fechaPago: p && p.fechaPago ? String(p.fechaPago) : "",
              monto: Number.isFinite(Number(p && p.monto)) ? Number(p.monto) : 0
            }))
          : def.prestamos,
        metas: Array.isArray(rawObj.metas)
          ? rawObj.metas.map((m, idx) => ({
              id: m && m.id ? m.id : Date.now() + idx,
              nombre: m && m.nombre ? String(m.nombre) : `Meta ${idx + 1}`,
              objetivo: Number.isFinite(Number(m && m.objetivo)) ? Number(m.objetivo) : 0,
              ahorrado: Number.isFinite(Number(m && m.ahorrado)) ? Number(m.ahorrado) : 0
            }))
          : def.metas,
        gastos: Array.isArray(rawObj.gastos)
          ? rawObj.gastos.map((g, idx) => ({
              id: g && g.id ? g.id : Date.now() + idx,
              fecha: g && g.fecha ? String(g.fecha) : "2026-11-01",
              categoria: g && g.categoria ? String(g.categoria) : "Otros",
              subcategoria: g && g.subcategoria ? String(g.subcategoria) : "General",
              descripcion: g && g.descripcion ? String(g.descripcion) : "",
              tipo: g && g.tipo === "Innecesario" ? "Innecesario" : "Necesario",
              monto: Number.isFinite(Number(g && g.monto)) ? Number(g.monto) : 0,
              metodo: g && g.metodo ? String(g.metodo) : "Efectivo"
            }))
          : def.gastos,
        ingresos: Array.isArray(rawObj.ingresos)
          ? rawObj.ingresos.map((i, idx) => ({
              id: i && i.id ? i.id : Date.now() + idx,
              fecha: i && i.fecha ? String(i.fecha) : "2026-11-01",
              fuente: i && i.fuente ? String(i.fuente) : "Otros",
              descripcion: i && i.descripcion ? String(i.descripcion) : "",
              monto: Number.isFinite(Number(i && i.monto)) ? Number(i.monto) : 0,
              destino: i && i.destino ? String(i.destino) : "Efectivo"
            }))
          : def.ingresos
      };
    }

    let appState = normalizeState(getDefaultData());

    function loadAppState() {
      try {
        const raw = readStorageRaw();
        if (!raw) {
          appState = getDefaultData();
          saveAppState();
          return;
        }
        appState = normalizeState(JSON.parse(raw));
      } catch (err) {
        appState = getDefaultData();
        showErrorBanner("Datos corruptos recuperados con valores por defecto: " + err.message);
      }
    }

    function saveAppState() {
      try {
        writeStorageRaw(JSON.stringify(appState));
      } catch (err) {
        showErrorBanner("No se pudo serializar el estado: " + err.message);
      }
    }

    // =========================================================================
    // FUNCIONES DE FECHA, FORMATO Y NOTIFICACIÓN
    // =========================================================================
    function parseDateParts(dateStr) {
      const clean = String(dateStr || "").trim();
      const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(clean);
      if (!match) {
        return { mes: "Noviembre", anio: 2026, semana: "Semana 1", dia: 1 };
      }
      const anio = parseInt(match[1], 10);
      const mesIdx = parseInt(match[2], 10) - 1;
      const dia = parseInt(match[3], 10);
      const mes = MESES[mesIdx] || "Enero";
      const numSem = Math.min(5, Math.max(1, Math.ceil(dia / 7)));
      return { mes, anio, semana: `Semana ${numSem}`, dia };
    }

    function getSampleDateForPeriod(mesNombre, anioNum) {
      const idx = MESES.indexOf(mesNombre);
      const mesNum = String((idx >= 0 ? idx : 10) + 1).padStart(2, "0");
      return `${anioNum}-${mesNum}-15`;
    }

    function fmtMoney(n) {
      const val = Number(n);
      if (!Number.isFinite(val)) return "$0.00";
      const sign = val < 0 ? "-" : "";
      return `${sign}$${Math.abs(val).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    }

    function fmtPct(ratio) {
      if (!Number.isFinite(ratio)) return "0.0%";
      return `${(ratio * 100).toFixed(1)}%`;
    }

    function notify(msg) {
      const box = document.getElementById("toast-box");
      if (!box) return;
      const item = document.createElement("div");
      item.className = "toast-msg";
      item.textContent = msg;
      box.appendChild(item);
      setTimeout(() => {
        if (item && item.parentNode) item.parentNode.removeChild(item);
      }, 2600);
    }

    // =========================================================================
    // NAVEGACIÓN ENTRE PESTAÑAS
    // =========================================================================
    function switchTab(tabId) {
      const validTabs = ["dashboard", "gastos", "ingresos", "config", "anual"];
      const target = validTabs.includes(tabId) ? tabId : "dashboard";

      validTabs.forEach(id => {
        const panel = document.getElementById(`panel-${id}`);
        if (panel) panel.classList.toggle("active", id === target);
      });

      document.querySelectorAll(".tab-btn").forEach(btn => {
        btn.classList.toggle("active", btn.getAttribute("data-tab") === target);
      });

      if (target === "dashboard") renderDashboardTab();
      if (target === "gastos") renderGastosTab();
      if (target === "ingresos") renderIngresosTab();
      if (target === "config") renderConfigTab();
      if (target === "anual") renderAnualTab();
    }

    function quickAddMovement(kind) {
      const mes = appState.activeMes;
      const anio = appState.activeAnio;
      const fechaSugerida = getSampleDateForPeriod(mes, anio);
      if (kind === "gasto") {
        switchTab("gastos");
        const fInput = document.getElementById("g-fecha");
        if (fInput) fInput.value = fechaSugerida;
        const fgMes = document.getElementById("fg-mes");
        const fgAnio = document.getElementById("fg-anio");
        if (fgMes) fgMes.value = mes;
        if (fgAnio) fgAnio.value = String(anio);
        renderGastosTab();
      } else {
        switchTab("ingresos");
        const iInput = document.getElementById("i-fecha");
        if (iInput) iInput.value = fechaSugerida;
        const fiMes = document.getElementById("fi-mes");
        const fiAnio = document.getElementById("fi-anio");
        if (fiMes) fiMes.value = mes;
        if (fiAnio) fiAnio.value = String(anio);
        renderIngresosTab();
      }
    }

