    // =========================================================================
    // GRÁFICOS NATIVOS EN CANVAS (Sin dependencia de red)
    // =========================================================================
    function prepareCanvas(canvasId, heightPx) {
      const canvas = document.getElementById(canvasId);
      if (!canvas) return null;
      const parentWidth = canvas.parentElement && canvas.parentElement.clientWidth ? canvas.parentElement.clientWidth : 600;
      const width = Math.max(280, parentWidth - 4);
      const height = heightPx || canvas.height || 240;
      canvas.width = width;
      canvas.height = height;
      const ctx = canvas.getContext("2d");
      ctx.clearRect(0, 0, width, height);
      return { ctx, width, height };
    }

    function drawBarChart(canvasId, labels, values, colorHex, titleTag) {
      const info = prepareCanvas(canvasId, 280);
      if (!info) return;
      const { ctx, width, height } = info;

      const padLeft = 148;
      const padRight = 56;
      const padTop = 18;
      const padBottom = 26;
      const plotW = Math.max(80, width - padLeft - padRight);
      const plotH = Math.max(80, height - padTop - padBottom);

      const maxVal = Math.max(1, ...values.map(v => Number(v) || 0));
      const rowH = plotH / Math.max(1, labels.length);

      ctx.font = "11px sans-serif";
      ctx.textBaseline = "middle";

      for (let i = 0; i < labels.length; i++) {
        const val = Number(values[i]) || 0;
        const yCenter = padTop + i * rowH + rowH / 2;
        const barW = Math.max(0, (val / maxVal) * plotW);
        const barH = Math.max(6, Math.min(15, rowH * 0.62));

        ctx.fillStyle = "#334155";
        ctx.textAlign = "right";
        const shortLabel = labels[i].length > 21 ? labels[i].slice(0, 20) + "…" : labels[i];
        ctx.fillText(shortLabel, padLeft - 8, yCenter);

        ctx.fillStyle = "#f1f5f9";
        ctx.fillRect(padLeft, yCenter - barH / 2, plotW, barH);

        ctx.fillStyle = colorHex;
        ctx.fillRect(padLeft, yCenter - barH / 2, barW, barH);

        ctx.fillStyle = "#0f172a";
        ctx.textAlign = "left";
        ctx.fillText(`$${val.toFixed(2)}`, padLeft + barW + 6, yCenter);
      }

      ctx.fillStyle = "#64748b";
      ctx.textAlign = "right";
      ctx.fillText(`Escala máx: $${maxVal.toFixed(0)} (${titleTag})`, width - 8, height - 8);
    }

    function drawDonutChart(canvasId, labels, values, colors) {
      const info = prepareCanvas(canvasId, 210);
      if (!info) return;
      const { ctx, width, height } = info;

      const total = values.reduce((a, b) => a + (Number(b) || 0), 0);
      const cx = width * 0.36;
      const cy = height * 0.5;
      const rOuter = Math.max(36, Math.min(cx - 14, cy - 14));
      const rInner = rOuter * 0.58;

      if (total <= 0) {
        ctx.beginPath();
        ctx.arc(cx, cy, rOuter, 0, Math.PI * 2);
        ctx.fillStyle = "#e2e8f0";
        ctx.fill();
        ctx.beginPath();
        ctx.arc(cx, cy, rInner, 0, Math.PI * 2);
        ctx.fillStyle = "#ffffff";
        ctx.fill();
        ctx.fillStyle = "#64748b";
        ctx.font = "bold 12px sans-serif";
        ctx.textAlign = "center";
        ctx.fillText("Sin gastos", cx, cy + 4);
        return;
      }

      let startAngle = -Math.PI / 2;
      values.forEach((v, idx) => {
        const val = Number(v) || 0;
        const slice = (val / total) * Math.PI * 2;
        ctx.beginPath();
        ctx.moveTo(cx, cy);
        ctx.arc(cx, cy, rOuter, startAngle, startAngle + slice);
        ctx.closePath();
        ctx.fillStyle = colors[idx] || "#0d9488";
        ctx.fill();
        startAngle += slice;
      });

      ctx.beginPath();
      ctx.arc(cx, cy, rInner, 0, Math.PI * 2);
      ctx.fillStyle = "#ffffff";
      ctx.fill();

      // Leyenda a la derecha
      const legX = cx + rOuter + 18;
      let legY = cy - 22;
      ctx.textAlign = "left";
      labels.forEach((lbl, idx) => {
        const val = Number(values[idx]) || 0;
        const pct = ((val / total) * 100).toFixed(1);
        ctx.fillStyle = colors[idx] || "#0d9488";
        ctx.fillRect(legX, legY - 5, 11, 11);
        ctx.fillStyle = "#0f172a";
        ctx.font = "bold 12px sans-serif";
        ctx.fillText(`${lbl} (${pct}%)`, legX + 16, legY + 1);
        ctx.fillStyle = "#64748b";
        ctx.font = "11px sans-serif";
        ctx.fillText(`$${val.toFixed(2)}`, legX + 16, legY + 15);
        legY += 38;
      });
    }

    function drawGroupedAnnualChart(canvasId, labels, ingresosArr, gastosArr) {
      const info = prepareCanvas(canvasId, 260);
      if (!info) return;
      const { ctx, width, height } = info;

      const padLeft = 52;
      const padRight = 18;
      const padTop = 28;
      const padBottom = 28;
      const plotW = Math.max(100, width - padLeft - padRight);
      const plotH = Math.max(80, height - padTop - padBottom);

      const maxVal = Math.max(10, ...ingresosArr, ...gastosArr);
      const groupW = plotW / labels.length;
      const barW = Math.max(4, Math.min(14, groupW * 0.32));

      // Leyenda arriba
      ctx.font = "bold 11.5px sans-serif";
      ctx.fillStyle = "#059669";
      ctx.fillRect(padLeft, 8, 12, 12);
      ctx.fillText("Ingresos ($)", padLeft + 17, 18);

      ctx.fillStyle = "#e11d48";
      ctx.fillRect(padLeft + 115, 8, 12, 12);
      ctx.fillText("Gastos ($)", padLeft + 132, 18);

      ctx.strokeStyle = "#e2e8f0";
      ctx.beginPath();
      ctx.moveTo(padLeft, padTop + plotH);
      ctx.lineTo(padLeft + plotW, padTop + plotH);
      ctx.stroke();

      ctx.textAlign = "center";
      ctx.font = "11px sans-serif";

      labels.forEach((mesShort, i) => {
        const gx = padLeft + i * groupW + groupW / 2;
        const ing = Number(ingresosArr[i]) || 0;
        const gas = Number(gastosArr[i]) || 0;

        const hIng = (ing / maxVal) * plotH;
        const hGas = (gas / maxVal) * plotH;

        ctx.fillStyle = "#059669";
        ctx.fillRect(gx - barW - 1, padTop + plotH - hIng, barW, hIng);

        ctx.fillStyle = "#e11d48";
        ctx.fillRect(gx + 1, padTop + plotH - hGas, barW, hGas);

        ctx.fillStyle = "#334155";
        ctx.fillText(mesShort, gx, padTop + plotH + 15);
      });

      ctx.textAlign = "right";
      ctx.fillStyle = "#64748b";
      ctx.fillText(`$${maxVal.toFixed(0)}`, padLeft - 6, padTop + 4);
      ctx.fillText("$0", padLeft - 6, padTop + plotH);
    }

    // =========================================================================
    // EXPORTACIÓN (.XLSX VÍA SHEETJS O CSV DE RESGUARDO) Y JSON
    // =========================================================================
    function exportExcelOrCsv() {
      const gastosRows = appState.gastos.map(g => {
        const p = parseDateParts(g.fecha);
        return {
          Fecha: g.fecha,
          Mes: p.mes,
          Anio: p.anio,
          Semana: p.semana,
          Categoria: g.categoria,
          Subcategoria: g.subcategoria,
          Descripcion: g.descripcion,
          Tipo_Gasto: g.tipo,
          Monto: Number(g.monto) || 0,
          Metodo: g.metodo
        };
      });

      if (window.XLSX && typeof window.XLSX.utils !== "undefined") {
        try {
          const wb = window.XLSX.utils.book_new();
          window.XLSX.utils.book_append_sheet(wb, window.XLSX.utils.json_to_sheet(gastosRows), "Gastos");

          const ingresosRows = appState.ingresos.map(i => {
            const p = parseDateParts(i.fecha);
            return {
              Fecha: i.fecha,
              Mes: p.mes,
              Anio: p.anio,
              Fuente: i.fuente,
              Descripcion: i.descripcion,
              Monto: Number(i.monto) || 0,
              Destino: i.destino
            };
          });
          window.XLSX.utils.book_append_sheet(wb, window.XLSX.utils.json_to_sheet(ingresosRows), "Ingresos");

          const anualRows = MESES.map(m => {
            const s = getMonthSummary(m, appState.activeAnio);
            return {
              Mes: m,
              Capital_Inicial: s.capitalInicial,
              Ingresos: s.totalIngresos,
              Gastos_Totales: s.totalGastos,
              Gasto_Necesario: s.gastoNecesario,
              Gasto_Innecesario: s.gastoInnecesario,
              Ahorro_Neto: s.ahorroNeto,
              Capital_Cierre: s.capitalActual
            };
          });
          window.XLSX.utils.book_append_sheet(wb, window.XLSX.utils.json_to_sheet(anualRows), "Resumen_Anual");

          window.XLSX.writeFile(wb, `Control_Financiero_Personal_${appState.activeAnio}.xlsx`);
          notify("Exportado a Excel (.xlsx)");
          return;
        } catch (e) {
          // Si SheetJS falla, cae automáticamente a CSV
        }
      }

      // Respaldo CSV compatible con Excel
      const headers = ["Fecha", "Mes", "Anio", "Semana", "Categoria", "Subcategoria", "Descripcion", "Tipo_Gasto", "Monto", "Metodo"];
      const csvLines = [
        headers.join(","),
        ...gastosRows.map(r => headers.map(h => `"${String(r[h]).replace(/"/g, '""')}"`).join(","))
      ];
      const blob = new Blob(["\uFEFF" + csvLines.join("\n")], { type: "text/csv;charset=utf-8;" });
      downloadBlob(blob, `Gastos_${appState.activeAnio}.csv`);
      notify("Exportado a CSV compatible con Excel");
    }

    function exportJsonBackup() {
      const blob = new Blob([JSON.stringify(appState, null, 2)], { type: "application/json" });
      downloadBlob(blob, `Control_Financiero_2026_Respaldo.json`);
      notify("Respaldo JSON descargado");
    }

    function downloadBlob(blob, filename) {
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    }

    // =========================================================================
    // ARRANQUE SEGURO
    // =========================================================================
    function renderAllTabs() {
      renderDashboardTab();
      renderGastosTab();
      renderIngresosTab();
      renderConfigTab();
      renderAnualTab();
    }

    document.addEventListener("DOMContentLoaded", function () {
      try {
        loadAppState();
        const today = new Date().toISOString().slice(0, 10);
        const gFecha = document.getElementById("g-fecha");
        const iFecha = document.getElementById("i-fecha");
        if (gFecha) gFecha.value = today;
        if (iFecha) iFecha.value = today;

        syncAllSelects();
        renderAllTabs();
      } catch (err) {
        showErrorBanner("Error al iniciar la aplicación: " + (err && err.message ? err.message : String(err)));
      }
    });

    window.addEventListener("resize", function () {
      const activePanel = document.querySelector(".tab-panel.active");
      if (!activePanel) return;
      if (activePanel.id === "panel-dashboard") renderDashboardTab();
      if (activePanel.id === "panel-anual") renderAnualTab();
    });
  </script>
