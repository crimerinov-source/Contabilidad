      const gCat = document.getElementById("g-categoria");
      const fgCat = document.getElementById("fg-categoria");
      if (gCat) gCat.innerHTML = catOpts;
      if (fgCat) fgCat.innerHTML = `<option value="">Todas las Categorías</option>` + catOpts;

