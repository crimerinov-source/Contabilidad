<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Control Financiero Personal 2026</title>
  <!-- SheetJS opcional para exportacion .xlsx; si no carga, hay exportacion CSV/JSON garantizada -->
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js" defer></script>
  <style>
    :root {
      --bg: #f4f6f9;
      --surface: #ffffff;
      --surface-alt: #f8fafc;
      --ink: #0f172a;
      --muted: #64748b;
      --line: #e2e8f0;
      --navy: #0f172a;
      --navy-2: #1e293b;
      --teal: #0d9488;
      --teal-dark: #0f766e;
      --teal-soft: #f0fdfa;
      --emerald: #059669;
      --emerald-soft: #ecfdf5;
      --rose: #e11d48;
      --rose-soft: #fff1f2;
      --amber: #d97706;
      --amber-soft: #fffbeb;
      --sky: #0284c7;
      --sky-soft: #f0f9ff;
      --radius: 14px;
      --radius-sm: 9px;
      --shadow: 0 2px 10px rgba(15, 23, 42, 0.05);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Inter, Arial, sans-serif;
      background: var(--bg);
      color: var(--ink);
      line-height: 1.45;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .num {
      font-variant-numeric: tabular-nums;
    }

    /* Banner de errores globales para evitar pantalla en blanco */
    #error-banner {
      display: none;
      background: #7f1d1d;
      color: #fef2f2;
      padding: 12px 18px;
      font-size: 13px;
      border-bottom: 2px solid #fca5a5;
      z-index: 9999;
    }

    #error-banner strong {
      display: block;
      margin-bottom: 3px;
    }

    /* Encabezado superior */
    header.app-header {
      background: linear-gradient(135deg, var(--navy) 0%, var(--navy-2) 100%);
      color: #ffffff;
      position: sticky;
      top: 0;
      z-index: 50;
      box-shadow: 0 4px 16px rgba(15, 23, 42, 0.16);
    }

    .header-inner {
      max-width: 1440px;
      margin: 0 auto;
      padding: 12px 18px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 11px;
    }

    .brand-badge {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      background: var(--teal);
      color: #fff;
      display: grid;
      place-items: center;
      font-weight: 800;
      font-size: 16px;
      flex-shrink: 0;
    }

    .brand h1 {
      margin: 0;
      font-size: 17px;
      font-weight: 800;
      letter-spacing: -0.01em;
    }

    .brand p {
      margin: 0;
      font-size: 11.5px;
      color: #94a3b8;
    }

    .nav-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .tab-btn {
      appearance: none;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: rgba(255, 255, 255, 0.06);
      color: #cbd5e1;
      padding: 8px 13px;
      border-radius: var(--radius-sm);
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .tab-btn:hover {
      background: rgba(255, 255, 255, 0.14);
      color: #ffffff;
    }

    .tab-btn.active {
      background: var(--teal);
      border-color: var(--teal);
      color: #ffffff;
      box-shadow: 0 2px 10px rgba(13, 148, 136, 0.4);
    }

    /* Contenedor principal */
    main {
      max-width: 1440px;
      width: 100%;
      margin: 0 auto;
      padding: 18px;
      flex: 1;
    }

    .tab-panel {
      display: none;
    }

    .tab-panel.active {
      display: block;
    }

    /* Tarjetas y bloques */
    .card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 16px 18px;
      margin-bottom: 16px;
    }

    .card-header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 12px;
    }

    .card-title {
      margin: 0;
      font-size: 15px;
      font-weight: 700;
      color: var(--ink);
    }

    .card-sub {
      margin: 2px 0 0;
      font-size: 12px;
      color: var(--muted);
    }

    /* Barra de periodo */
    .period-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .period-controls {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px;
    }

    .field-inline {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--surface-alt);
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
      padding: 6px 10px;
      font-size: 12.5px;
      font-weight: 600;
      color: var(--muted);
    }

    select,
    input[type="text"],
    input[type="number"],
    input[type="date"] {
      font-family: inherit;
      font-size: 13px;
      color: var(--ink);
      background: #ffffff;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      padding: 7px 10px;
      outline: none;
    }

    select:focus,
    input:focus {
      border-color: var(--teal);
      box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.14);
    }

    .select-highlight {
      background: #fef3c7;
      border-color: #f59e0b;
      font-weight: 700;
    }

    .pill-counter {
      background: var(--teal-soft);
      color: var(--teal-dark);
      border: 1px solid #99f6e4;
      padding: 6px 12px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
    }

    .cap-inicial-box {
      background: var(--navy);
      color: #ffffff;
      border-radius: 12px;
      padding: 10px 16px;
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .cap-inicial-box small {
      display: block;
      font-size: 10.5px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: #94a3b8;
    }

    .cap-inicial-box strong {
      font-size: 18px;
      font-weight: 800;
      color: #2dd4bf;
    }

    /* Botones */
    .btn {
      appearance: none;
      border: 1px solid transparent;
      border-radius: var(--radius-sm);
      padding: 8px 13px;
      font-size: 12.5px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.15s ease;
    }

    .btn-primary {
      background: var(--teal);
      color: #ffffff;
    }

    .btn-primary:hover {
      background: var(--teal-dark);
    }

    .btn-secondary {
      background: #ffffff;
      color: var(--ink);
      border-color: #cbd5e1;
    }

    .btn-secondary:hover {
      background: var(--surface-alt);
    }

    .btn-danger-soft {
      background: var(--rose-soft);
      color: var(--rose);
      border-color: #fecdd3;
    }

    .btn-danger-soft:hover {
      background: #ffe4e6;
    }

    .btn-success-soft {
      background: var(--emerald-soft);
      color: var(--emerald);
      border-color: #a7f3d0;
    }

    .btn-success-soft:hover {
      background: #d1fae5;
    }

    .btn-sm {
      padding: 5px 9px;
      font-size: 11.5px;
    }

    /* 6 Tarjetas KPI */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(205px, 1fr));
      gap: 12px;
      margin-bottom: 16px;
    }

    .kpi-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 15px 16px;
      box-shadow: var(--shadow);
    }

    .kpi-card.hero {
      background: linear-gradient(135deg, var(--navy) 0%, var(--navy-2) 100%);
      color: #ffffff;
      border-color: var(--navy);
    }

    .kpi-card.warn-tint {
      background: var(--amber-soft);
      border-color: #fde68a;
    }

    .kpi-label {
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--muted);
      margin-bottom: 6px;
    }

    .kpi-card.hero .kpi-label {
      color: #5eead4;
    }

    .kpi-card.warn-tint .kpi-label {
      color: #92400e;
    }

    .kpi-value {
      font-size: 23px;
      font-weight: 800;
      line-height: 1.15;
    }

    .kpi-sub {
      font-size: 11.5px;
      color: var(--muted);
      margin-top: 5px;
    }

    .kpi-card.hero .kpi-sub {
      color: #94a3b8;
    }

    /* Grillas de contenido */
    .grid-2 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 16px;
      margin-bottom: 16px;
    }

    .grid-dash-main {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: 16px;
      align-items: start;
    }

    @media (max-width: 1024px) {
      .grid-dash-main {
        grid-template-columns: 1fr;
      }
    }

    /* Tablas */
    .table-wrap {
      width: 100%;
      overflow-x: auto;
      border: 1px solid var(--line);
      border-radius: 10px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    thead th {
      background: var(--navy);
      color: #ffffff;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      padding: 10px 10px;
      text-align: left;
      white-space: nowrap;
    }

    thead th.right,
    tbody td.right,
    tfoot td.right {
      text-align: right;
    }

    thead th.center,
    tbody td.center,
    tfoot td.center {
      text-align: center;
    }

    tbody td {
      padding: 8px 10px;
      border-top: 1px solid var(--line);
      vertical-align: middle;
    }

    tbody tr:hover {
      background: #f8fafc;
    }

    tfoot td {
      background: #f1f5f9;
      font-weight: 800;
      padding: 10px 10px;
      border-top: 2px solid #cbd5e1;
    }

    tfoot.total-dark td {
      background: var(--navy);
      color: #ffffff;
      border-top-color: var(--navy);
    }

    /* Semaforo presupuesto y badges */
    .badge {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 999px;
      font-size: 11.5px;
      font-weight: 700;
    }

    .badge-ok {
      background: var(--emerald-soft);
      color: var(--emerald);
      border: 1px solid #a7f3d0;
    }

    .badge-warn {
      background: var(--amber-soft);
      color: var(--amber);
      border: 1px solid #fde68a;
    }

    .badge-over {
      background: var(--rose-soft);
      color: var(--rose);
      border: 1px solid #fecdd3;
    }

    .progress-bar {
      width: 90px;
      height: 8px;
      background: #e2e8f0;
      border-radius: 999px;
      overflow: hidden;
      display: inline-block;
      vertical-align: middle;
      margin-right: 6px;
    }

    .progress-fill {
      height: 100%;
      background: var(--teal);
      border-radius: 999px;
    }

    /* Formularios y filtros */
    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 10px;
      align-items: end;
    }

    .form-group label {
      display: block;
      font-size: 11.5px;
      font-weight: 700;
      color: var(--muted);
      margin-bottom: 4px;
    }

    .form-group input,
    .form-group select {
      width: 100%;
    }

    .filters-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      align-items: center;
      margin-bottom: 12px;
    }

    /* Canvas charts */
    canvas.chart-canvas {
      width: 100%;
      display: block;
      background: #ffffff;
      border-radius: 10px;
    }

    .chip-list {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 8px;
    }

    .chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--surface-alt);
      border: 1px solid #cbd5e1;
      border-radius: 999px;
      padding: 4px 10px;
      font-size: 12px;
      font-weight: 600;
    }

    .chip button {
      border: none;
      background: transparent;
      color: var(--rose);
      font-weight: 800;
      cursor: pointer;
      padding: 0 2px;
    }

    .toast-box {
      position: fixed;
      right: 16px;
      bottom: 16px;
      z-index: 9000;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .toast-msg {
      background: var(--navy);
      color: #ffffff;
      border-left: 4px solid var(--teal);
      padding: 10px 14px;
      border-radius: 10px;
      font-size: 12.5px;
      font-weight: 600;
      box-shadow: 0 8px 20px rgba(15, 23, 42, 0.25);
    }

    footer {
      max-width: 1440px;
      width: 100%;
      margin: 0 auto;
      padding: 12px 18px 20px;
      font-size: 12px;
      color: var(--muted);
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 8px;
    }
  </style>
</head>
<body>
  <!-- Aviso de error global para que nunca quede en blanco -->
  <div id="error-banner" role="alert">
    <strong>Se detectó un error en la aplicación (recuperado de forma segura):</strong>
    <span id="error-detail"></span>
  </div>

  <!-- Encabezado y 5 Pestañas -->
  <header class="app-header">
    <div class="header-inner">
      <div class="brand">
        <div class="brand-badge">CF</div>
        <div>
          <h1>Control Financiero Personal 2026</h1>
          <p>Libro personal en HTML • Guardado automático local • Sin dependencias bloqueantes</p>
        </div>
      </div>

      <nav class="nav-tabs" aria-label="Secciones principales">
        <button type="button" class="tab-btn active" data-tab="dashboard" onclick="switchTab('dashboard')">1. Resumen Dashboard</button>
        <button type="button" class="tab-btn" data-tab="gastos" onclick="switchTab('gastos')">2. Gastos</button>
        <button type="button" class="tab-btn" data-tab="ingresos" onclick="switchTab('ingresos')">3. Ingresos</button>
        <button type="button" class="tab-btn" data-tab="config" onclick="switchTab('config')">4. Config Listas</button>
        <button type="button" class="tab-btn" data-tab="anual" onclick="switchTab('anual')">5. Resumen Anual</button>
      </nav>
    </div>
  </header>

  <main>
    <!-- ===================================================================== -->
    <!-- PESTAÑA 1: RESUMEN DASHBOARD                                          -->
    <!-- ===================================================================== -->
    <section id="panel-dashboard" class="tab-panel active">
      <div class="card">
        <div class="period-bar">
          <div class="period-controls">
            <div class="field-inline">
              <label for="dash-mes">Mes:</label>
              <select id="dash-mes" class="select-highlight" onchange="onDashboardPeriodChange()"></select>
            </div>
            <div class="field-inline">
              <label for="dash-anio">Año:</label>
              <select id="dash-anio" class="select-highlight" onchange="onDashboardPeriodChange()">
                <option value="2025">2025</option>
                <option value="2026" selected>2026</option>
                <option value="2027">2027</option>
              </select>
            </div>
            <span id="dash-contador" class="pill-counter num">0 movimientos en el periodo</span>
            <button type="button" class="btn btn-danger-soft btn-sm" onclick="quickAddMovement('gasto')">+ Gasto en este mes</button>
            <button type="button" class="btn btn-success-soft btn-sm" onclick="quickAddMovement('ingreso')">+ Ingreso en este mes</button>
          </div>

          <div class="cap-inicial-box">
            <div>
              <small>Capital Inicial (<span id="dash-cap-mes-label">Noviembre</span>)</small>
              <strong id="dash-cap-inicial" class="num">$727.75</strong>
            </div>
            <button type="button" class="btn btn-secondary btn-sm" onclick="switchTab('config')">Editar por mes</button>
          </div>
        </div>
      </div>

      <!-- 6 Tarjetas KPI Grandes -->
      <div class="kpi-grid">
        <div class="kpi-card hero">
          <div class="kpi-label">Capital Actual Disponible</div>
          <div id="kpi-capital-actual" class="kpi-value num">$0.00</div>
          <div class="kpi-sub">Capital Inicial + Ahorro Neto del mes</div>
        </div>
        <div class="kpi-card">
          <div class="kpi-label">Ingresos del Mes</div>
          <div id="kpi-ingresos" class="kpi-value num" style="color: var(--emerald);">$0.00</div>
          <div class="kpi-sub">Total ingresos en periodo elegido</div>
        </div>
        <div class="kpi-card">
          <div class="kpi-label">Gastos Totales del Mes</div>
          <div id="kpi-gastos" class="kpi-value num" style="color: var(--rose);">$0.00</div>
          <div class="kpi-sub">Total gastos en periodo elegido</div>
        </div>
        <div class="kpi-card">
          <div class="kpi-label">Ahorro Neto del Mes</div>
          <div id="kpi-ahorro-neto" class="kpi-value num">$0.00</div>
          <div class="kpi-sub">Ingresos − Gastos del mes</div>
        </div>
        <div class="kpi-card warn-tint">
          <div class="kpi-label">Gasto Innecesario / Ahorro Posible</div>
          <div id="kpi-innecesario" class="kpi-value num" style="color: #b45309;">$0.00</div>
          <div class="kpi-sub">Gastos evitables del mes elegido</div>
        </div>
        <div class="kpi-card">
          <div class="kpi-label">% de Ahorro del Mes</div>
          <div id="kpi-pct-ahorro" class="kpi-value num" style="color: var(--teal-dark);">0.0%</div>
          <div class="kpi-sub">Ahorro Neto ÷ Ingresos del mes</div>
        </div>
      </div>

      <!-- 2 Gráficos Nativos en Canvas -->
      <div class="grid-2">
        <div class="card">
          <div class="card-header">
            <div>
              <h2 class="card-title">Gastos por Categoría ($)</h2>
              <p class="card-sub" id="chart-cat-sub">Periodo activo</p>
            </div>
          </div>
          <canvas id="canvas-categorias" class="chart-canvas" height="270"></canvas>
        </div>

        <div class="card">
          <div class="card-header">
            <div>
              <h2 class="card-title">Necesario vs. Innecesario</h2>
              <p class="card-sub" id="chart-cal-sub">Diagnóstico de ahorro potencial</p>
            </div>
          </div>
          <canvas id="canvas-calidad" class="chart-canvas" height="220"></canvas>
          <p id="diagnostico-calidad" class="card-sub" style="margin-top: 10px; font-weight: 600; color: var(--ink);"></p>
        </div>
      </div>

      <!-- Cuerpo Principal: Izquierda (Presupuesto + Calidad + Metas) / Derecha (Arqueo/Cuentas + Deudores) -->
      <div class="grid-dash-main">
        <div>
          <!-- Tabla Control de Gastos y Presupuesto por Categoría -->
          <div class="card">
            <div class="card-header">
              <div>
                <h2 class="card-title">Control de Gastos y Presupuesto por Categoría</h2>
                <p class="card-sub">Semáforo: verde &lt;80%, ámbar 80–100%, rojo &gt;100%. Puedes editar el presupuesto aquí.</p>
              </div>
            </div>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Categoría</th>
                    <th class="right">Presupuesto ($)</th>
                    <th class="right">Gastado ($)</th>
                    <th class="center">% Presupuesto</th>
                    <th class="right">% del Gasto</th>
                  </tr>
                </thead>
                <tbody id="tbody-dash-categorias"></tbody>
                <tfoot id="tfoot-dash-categorias" class="total-dark"></tfoot>
              </table>
            </div>
          </div>

          <!-- Tabla Calidad del Gasto -->
          <div class="card">
            <div class="card-header">
              <h2 class="card-title">Calidad del Gasto (Necesario vs. Innecesario)</h2>
            </div>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Tipo de Gasto</th>
                    <th class="right">Monto ($)</th>
                    <th class="right">% del Gasto</th>
                    <th>Lectura Financiera</th>
                  </tr>
                </thead>
                <tbody id="tbody-dash-calidad"></tbody>
              </table>
            </div>
          </div>

          <!-- Metas de Ahorro Personal -->
          <div class="card">
            <div class="card-header">
              <div>
                <h2 class="card-title">Metas de Ahorro Personal</h2>
                <p class="card-sub">Actualiza objetivo y ahorrado directamente</p>
              </div>
              <button type="button" class="btn btn-primary btn-sm" onclick="addMeta()">+ Nueva Meta</button>
            </div>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Meta</th>
                    <th class="right">Objetivo ($)</th>
                    <th class="right">Ahorrado ($)</th>
                    <th class="right">Falta ($)</th>
                    <th>% Avance</th>
                    <th class="center">Quitar</th>
                  </tr>
                </thead>
                <tbody id="tbody-metas"></tbody>
              </table>
            </div>
          </div>
        </div>

        <div>
          <!-- Capital por Lugar y Arqueo de Efectivo -->
          <div class="card">
            <div class="card-header">
              <div>
                <h2 class="card-title">Capital por Lugar y Arqueo de Efectivo</h2>
