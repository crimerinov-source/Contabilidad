            </td>
            <td class="right num">${fmtMoney(falta)}</td>
            <td>
              <div class="progress-bar"><div class="progress-fill" style="width: ${(pct * 100).toFixed(0)}%;"></div></div>
              <span class="num" style="font-size: 12px; font-weight: 700;">${fmtPct(pct)}</span>
