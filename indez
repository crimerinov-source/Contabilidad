          return window.localStorage.getItem(STORAGE_KEY);
        }
      } catch (e) {
        // localStorage bloqueado por sandbox o privacidad
      }
      return memoryFallbackStorage;
    }

    function writeStorageRaw(text) {
      memoryFallbackStorage = text;
      const statusEl = document.getElementById("storage-status");
      try {
        if (window.localStorage) {
          window.localStorage.setItem(STORAGE_KEY, text);
          if (statusEl) statusEl.textContent = "Guardado automático en localStorage activo";
